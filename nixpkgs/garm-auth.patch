@@ -0,0 +1,45 @@
+package params
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strconv"
+	"testing"
+	"time"
+)
+
+type transportFunc func(*http.Request) (*http.Response, error)
+
+func (f transportFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+func TestPrimaryResetPausesSharedAppTraffic(t *testing.T) {
+	calls := 0
+	tr := &pacedAppTransport{inner: transportFunc(func(r *http.Request) (*http.Response, error) {
+		calls++
+		return &http.Response{StatusCode: 403, Header: http.Header{"X-Ratelimit-Remaining": []string{"0"}, "X-Ratelimit-Reset": []string{strconv.FormatInt(time.Now().Add(time.Hour).Unix(), 10)}}}, nil
+	})}
+	req, _ := http.NewRequest("GET", "https://example.invalid", nil)
+	if _, e := tr.RoundTrip(req); e != nil {
+		t.Fatal(e)
+	}
+	if time.Until(tr.next) < 59*time.Minute {
+		t.Fatal("primary reset not honored")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, e := tr.RoundTrip(req.WithContext(ctx)); !errors.Is(e, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", e)
+	}
+	if calls != 1 {
+		t.Fatal("request sent despite cooldown")
+	}
+}
+func TestWritesUseFivePointSlots(t *testing.T) {
+	tr := &pacedAppTransport{interval: time.Second}
+	if err := tr.wait(context.Background(), 5); err != nil {
+		t.Fatal(err)
+	}
+	if time.Until(tr.next) < 4*time.Second {
+		t.Fatal("write request was not weighted")
+	}
+}
