# Bound idle multiplexing even when a local include sets ControlPersist yes.
# SSH uses the first value; this does not time out active sessions.
Host *
	ControlPersist 5m

# Local drop-ins. Included before the host blocks below so a file here can
# override any host-specific setting; the ControlPersist bound above wins.
Include ~/.ssh/config.d/*

# The primary AI environment is the container, including for older local aliases.
Host warbler-ai
	HostName warbler-ai.bed.einic.org
	Port 22
	User cody-ai

Host warbler-ai-tailscale
	HostName warbler.little-moth.ts.net
	Port 2223
	User cody-ai

# Crow's AI container is reached through the host's port-2223 SSH proxy.
Host crow
	User cody
	Port 22

Host crow-ai
	HostName crow
	Port 2223
	User cody-ai

Host *
	ControlMaster auto
	ControlPath ~/.ssh/master-%r@%h:%p
	ServerAliveInterval 240
	TCPKeepAlive yes
