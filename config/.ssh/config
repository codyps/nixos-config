# Bound idle multiplexing even when a local include sets ControlPersist yes.
# SSH uses the first value; this does not time out active sessions.
Host *
	ControlPersist 5m

# The primary AI environment is the container, including for older local aliases.
Host warbler-ai
	HostName warbler-ai.bed.einic.org
	Port 22
	User cody-ai

Host warbler-ai-tailscale
	HostName warbler.little-moth.ts.net
	Port 2223
	User cody-ai

Include ~/.ssh/config.d/*

Host *
	ControlMaster auto
	ControlPath ~/.ssh/master-%r@%h:%p
	ServerAliveInterval 240
	TCPKeepAlive yes
