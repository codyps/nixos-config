@@ -0,0 +1,65 @@
+package scalesets
+
+import (
+	"context"
+	"sync"
+	"time"
+)
+
+// RemoteAuth exchanges use at most 400 points/minute. Combined with the App
+// REST limiter (300 points/minute), this leaves headroom below 900 points/minute.
+var registrationRequests = &authPacer{interval: 750 * time.Millisecond}
+
+type authPacer struct {
+	mu       sync.Mutex
+	turn     chan struct{}
+	next     time.Time
+	interval time.Duration
+}
+
+func (p *authPacer) deferFor(delay time.Duration) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	until := time.Now().Add(delay)
+	if until.After(p.next) {
+		p.next = until
+	}
+}
+func (p *authPacer) wait(ctx context.Context) error {
+	// A single waiter owns the next slot. Other callers queue without racing
+	// every timer tick, and cancellation also works while waiting for a turn.
+	p.mu.Lock()
+	if p.turn == nil {
+		p.turn = make(chan struct{}, 1)
+	}
+	turn := p.turn
+	p.mu.Unlock()
+	select {
+	case turn <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	defer func() { <-turn }()
+
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		p.mu.Lock()
+		now := time.Now()
+		delay := p.next.Sub(now)
+		if delay <= 0 {
+			p.next = now.Add(p.interval)
+			p.mu.Unlock()
+			return nil
+		}
+		p.mu.Unlock()
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
