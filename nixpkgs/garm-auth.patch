index 0000000..1c23e91
--- /dev/null
+++ b/util/github/scalesets/auth_cache.go
@@ -0,0 +1,42 @@
+package scalesets
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"sync"
+
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+	"github.com/google/go-github/v84/github"
+)
+
+// Listeners, reconciliation and legacy pool managers authenticate to the same
+// repository. Share their token cache, while keeping client/request state local.
+type repositoryAuth struct {
+	sync.Mutex
+	registration *github.RegistrationToken
+	actions      *params.ActionsServiceAdminInfoResponse
+}
+
+var repositoryAuthCache = struct {
+	sync.Mutex
+	entries map[[32]byte]*repositoryAuth
+}{entries: make(map[[32]byte]*repositoryAuth)}
+
+func sharedRepositoryAuth(cli common.GithubClient) (*repositoryAuth, error) {
+	entity := cli.GetEntity()
+	credential := entity.Credentials
+	material, err := json.Marshal([]any{entity.ForgeURL(), credential.AuthType, credential.APIBaseURL, credential.CABundle, credential.CredentialsPayload})
+	if err != nil {
+		return nil, err
+	}
+	key := sha256.Sum256(material)
+	repositoryAuthCache.Lock()
+	defer repositoryAuthCache.Unlock()
+	state := repositoryAuthCache.entries[key]
+	if state == nil {
+		state = &repositoryAuth{}
+		repositoryAuthCache.entries[key] = state
+	}
+	return state, nil
+}
