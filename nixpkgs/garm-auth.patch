@@ -0,0 +1,96 @@
+package params
+
+import (
+	"context"
+	"net/http"
+	"strconv"
+	"sync"
+	"time"
+)
+
+// Keep aggregate App traffic below GitHub's secondary point budget, including
+// per-repository tools queries during startup. GET costs one point; writes five.
+type pacedAppTransport struct {
+	inner    http.RoundTripper
+	interval time.Duration
+	mu       sync.Mutex
+	turn     chan struct{}
+	next     time.Time
+}
+
+func (p *pacedAppTransport) wait(ctx context.Context, cost int) error {
+	// A single waiter owns the next slot. Other callers queue without racing
+	// every timer tick, and cancellation also works while waiting for a turn.
+	p.mu.Lock()
+	if p.turn == nil {
+		p.turn = make(chan struct{}, 1)
+	}
+	turn := p.turn
+	p.mu.Unlock()
+	select {
+	case turn <- struct{}{}:
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+	defer func() { <-turn }()
+
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		p.mu.Lock()
+		now := time.Now()
+		delay := p.next.Sub(now)
+		if delay <= 0 {
+			p.next = now.Add(time.Duration(cost) * p.interval)
+			p.mu.Unlock()
+			return nil
+		}
+		p.mu.Unlock()
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
+func (p *pacedAppTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	cost := 5
+	if req.Method == http.MethodGet || req.Method == http.MethodHead || req.Method == http.MethodOptions {
+		cost = 1
+	}
+	if err := p.wait(req.Context(), cost); err != nil {
+		return nil, err
+	}
+	resp, err := p.inner.RoundTrip(req)
+	if err != nil {
+		return resp, err
+	}
+	delay := time.Duration(0)
+	if resp.StatusCode == 429 || (resp.StatusCode == 403 && resp.Header.Get("Retry-After") != "") {
+		delay = time.Minute
+		if seconds, e := strconv.Atoi(resp.Header.Get("Retry-After")); e == nil && seconds > 0 {
+			delay = time.Duration(seconds) * time.Second
+		} else if deadline, e := http.ParseTime(resp.Header.Get("Retry-After")); e == nil && time.Until(deadline) > 0 {
+			delay = time.Until(deadline)
+		}
+	}
+	if resp.Header.Get("X-RateLimit-Remaining") == "0" {
+		if reset, e := strconv.ParseInt(resp.Header.Get("X-RateLimit-Reset"), 10, 64); e == nil && time.Until(time.Unix(reset, 0)) > delay {
+			delay = time.Until(time.Unix(reset, 0))
+		} else if delay == 0 {
+			delay = time.Minute
+		}
+	}
+	if delay > 0 {
+		p.mu.Lock()
+		until := time.Now().Add(delay)
+		if until.After(p.next) {
+			p.next = until
+		}
+		p.mu.Unlock()
+	}
+	return resp, nil
+}
