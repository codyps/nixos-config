+#[test]
+fn reuse_personalized_initrd_until_inputs_change() -> Result<()> {
+    use std::os::unix::fs::PermissionsExt;
+    let esp = tempdir()?;
+    let tmpdir = tempdir()?;
+    let profiles = tempdir()?;
+    let toplevel = common::setup_toplevel(tmpdir.path())?;
+    let generation = setup_generation_link_from_toplevel(&toplevel, profiles.path(), 1)?;
+    let appender = tmpdir.path().join("appender");
+    let overlay = tmpdir.path().join("overlay");
+    let counter = tmpdir.path().join("appends");
+    std::fs::write(&overlay, b"first overlay")?;
+    let shell = String::from_utf8(
+        std::process::Command::new("sh")
+            .args(["-c", "command -v sh"])
+            .output()?
+            .stdout,
+    )?;
+    let script = format!(
+        "#!{}\n# supports-initrd-content-check-v1\nif test \"${{2:-}}\" = --check-base; then\n  cat \"$3\" '{}' | cmp -s - \"$1\" && exit 0\n  exit 3\nfi\ncat '{}' >> \"$1\"\necho append >> '{}'\n",
+        shell.trim(),
+        overlay.display(),
+        overlay.display(),
+        counter.display()
+    );
+    std::fs::write(&appender, script)?;
+    std::fs::set_permissions(&appender, std::fs::Permissions::from_mode(0o700))?;
+    let bootspec_path = generation.join("boot.json");
+    let mut spec: serde_json::Value = serde_json::from_slice(&std::fs::read(&bootspec_path)?)?;
+    spec["org.nixos.bootspec.v1"]["initrdSecrets"] = serde_json::json!(appender);
+    std::fs::write(&bootspec_path, serde_json::to_vec(&spec)?)?;
+    let install = || common::lanzaboote_install(1, esp.path(), vec![generation.clone()]);
+    assert!(install()?.status.success());
+    let image = common::image_path(&esp, 1, &toplevel)?;
+    let initial = std::fs::read(&image)?;
+    let unsigned_hash = || -> Result<sha2::digest::Output<sha2::Sha256>> {
+        let copy = tmpdir.path().join("unsigned.efi");
+        std::fs::copy(&image, &copy)?;
+        remove_signature(&copy)?;
+        Ok(hash_file(&copy))
+    };
+    let initial_unsigned = unsigned_hash()?;
+    let modified = std::fs::metadata(&image)?.modified()?;
+    assert_eq!(std::fs::read_to_string(&counter)?.lines().count(), 1);
+    assert!(install()?.status.success());
+    assert_eq!(std::fs::read(&image)?, initial);
+    assert_eq!(std::fs::metadata(&image)?.modified()?, modified);
+    assert_eq!(std::fs::read_to_string(&counter)?.lines().count(), 1);
+    // Signing timestamps are outside the measured PE content. Compare stripped
+    // images after forcing assembly across a wall-clock second boundary.
+    std::fs::remove_file(&image)?;
+    std::thread::sleep(std::time::Duration::from_millis(1100));
+    assert!(install()?.status.success());
+    assert_eq!(unsigned_hash()?, initial_unsigned);
+    assert_eq!(std::fs::read_to_string(&counter)?.lines().count(), 2);
+    std::fs::write(&overlay, b"second overlay")?;
+    assert!(install()?.status.success());
+    assert_ne!(std::fs::read(&image)?, initial);
+    assert_eq!(std::fs::read_to_string(&counter)?.lines().count(), 3);
+    std::fs::write(
+        &appender,
+        format!(
+            "#!{}\n# supports-initrd-content-check-v1\nexit 1\n",
+            shell.trim()
+        ),
+    )?;
+    assert!(!install()?.status.success());
+    assert_eq!(std::fs::read_to_string(&counter)?.lines().count(), 3);
+    Ok(())
+}
