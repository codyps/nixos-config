@@ -0,0 +1,37 @@
+package entity
+
+import (
+	"github.com/cloudbase/garm/runner/common"
+	"testing"
+)
+
+type fixtureGithubClient struct{ common.GithubClient }
+
+func TestWorkerReusesActionsClientAndUpdatesCredentials(t *testing.T) {
+	first := &fixtureGithubClient{}
+	w := &Worker{ghCli: first}
+	a, err := w.getScaleSetClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := w.getScaleSetClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a != b {
+		t.Fatal("worker discarded its Actions token cache")
+	}
+	second := &fixtureGithubClient{}
+	w.ghCli = second
+	c, err := w.getScaleSetClient()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if c != a {
+		t.Fatal("worker replaced cache instead of updating credentials")
+	}
+	client, err := c.GetGithubClient()
+	if err != nil || client != second {
+		t.Fatal("updated credential client not used")
+	}
+}
