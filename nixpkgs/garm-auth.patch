@@ -0,0 +1,208 @@
+package scalesets
+
+import (
+	"context"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	runnerErrors "github.com/cloudbase/garm-provider-common/errors"
+	"github.com/cloudbase/garm/params"
+	"github.com/cloudbase/garm/runner/common"
+	"github.com/google/go-github/v84/github"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"testing"
+	"time"
+)
+
+func TestAuthPacerCancellationAndCooldown(t *testing.T) {
+	p := &authPacer{interval: time.Millisecond}
+	if err := p.wait(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	p.deferFor(time.Hour)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if !errors.Is(p.wait(ctx), context.Canceled) {
+		t.Fatal("cooldown ignored cancellation")
+	}
+	if time.Until(p.next) < 59*time.Minute {
+		t.Fatal("cooldown lost")
+	}
+}
+func TestRateLimitIsNotUnauthorized(t *testing.T) {
+	old := registrationRequests
+	registrationRequests = &authPacer{}
+	defer func() { registrationRequests = old }()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Retry-After", "120")
+		w.WriteHeader(403)
+		w.Write([]byte(`{"message":"secondary rate limit"}`))
+	}))
+	defer server.Close()
+	s := &ScaleSetClient{httpClient: server.Client()}
+	req, _ := http.NewRequest("GET", server.URL, nil)
+	_, err := s.Do(req)
+	if err == nil || errors.Is(err, runnerErrors.ErrUnauthorized) {
+		t.Fatalf("rate limit classified as credential failure: %v", err)
+	}
+	if time.Until(registrationRequests.next) < 119*time.Second {
+		t.Fatal("Retry-After ignored")
+	}
+}
+
+type registrationFake struct {
+	common.GithubClient
+	u       *url.URL
+	calls   int
+	err     error
+	payload string
+}
+
+func (f *registrationFake) CreateEntityRegistrationToken(context.Context) (*github.RegistrationToken, *github.Response, error) {
+	f.calls++
+	if f.err != nil {
+		return nil, nil, f.err
+	}
+	s := "fixture"
+	return &github.RegistrationToken{Token: &s, ExpiresAt: &github.Timestamp{Time: time.Now().Add(time.Hour)}}, nil, nil
+}
+func (f *registrationFake) GithubBaseURL() *url.URL { return f.u }
+func (f *registrationFake) GetEntity() params.ForgeEntity {
+	return params.ForgeEntity{Owner: "example", Name: "repo", EntityType: params.ForgeEntityTypeRepository, Credentials: params.ForgeCredentials{BaseURL: "https://github.com", CredentialsPayload: []byte(f.payload)}}
+}
+func TestRejectedRegistrationTokenIsDiscarded(t *testing.T) {
+	resetRepositoryAuth(t)
+	old := registrationRequests
+	registrationRequests = &authPacer{}
+	defer func() { registrationRequests = old }()
+	attempts := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		attempts++
+		if attempts == 1 {
+			w.WriteHeader(401)
+			return
+		}
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"url":"https://example.invalid/","token":"fixture"}`))
+	}))
+	defer server.Close()
+	u, _ := url.Parse(server.URL)
+	fake := &registrationFake{u: u}
+	s := &ScaleSetClient{httpClient: server.Client(), ghCli: fake}
+	if !errors.Is(s.ensureAdminInfo(context.Background()), runnerErrors.ErrUnauthorized) {
+		t.Fatal("expected rejection")
+	}
+	if s.runnerRegistrationToken != nil {
+		t.Fatal("rejected credential retained")
+	}
+	if err := s.ensureAdminInfo(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if fake.calls != 2 {
+		t.Fatal("token was not refreshed")
+	}
+}
+
+func TestRegistrationPrimaryLimitDefersAllRepositories(t *testing.T) {
+	resetRepositoryAuth(t)
+	old := registrationRequests
+	registrationRequests = &authPacer{}
+	defer func() { registrationRequests = old }()
+	req, _ := http.NewRequest("POST", "https://example.invalid", nil)
+	fake := &registrationFake{err: &github.RateLimitError{Rate: github.Rate{Reset: github.Timestamp{Time: time.Now().Add(time.Hour)}}, Response: &http.Response{StatusCode: 403, Request: req}}}
+	s := &ScaleSetClient{ghCli: fake}
+	if s.ensureAdminInfo(context.Background()) == nil {
+		t.Fatal("expected rate limit")
+	}
+	if time.Until(registrationRequests.next) < 59*time.Minute {
+		t.Fatal("primary reset ignored")
+	}
+}
+
+func TestCredentialClientChangeInvalidatesCachedActionsCredentials(t *testing.T) {
+	first := &registrationFake{}
+	second := &registrationFake{}
+	s := &ScaleSetClient{ghCli: first, runnerRegistrationToken: &github.RegistrationToken{}, actionsServiceInfo: &params.ActionsServiceAdminInfoResponse{}}
+	s.SetGithubClient(first)
+	if s.runnerRegistrationToken == nil || s.actionsServiceInfo == nil {
+		t.Fatal("unchanged credential discarded reusable tokens")
+	}
+	s.SetGithubClient(second)
+	if s.runnerRegistrationToken != nil || s.actionsServiceInfo != nil {
+		t.Fatal("changed credential retained old tokens")
+	}
+}
+
+func resetRepositoryAuth(t *testing.T) {
+	old := repositoryAuthCache.entries
+	repositoryAuthCache.entries = make(map[[32]byte]*repositoryAuth)
+	t.Cleanup(func() { repositoryAuthCache.entries = old })
+}
+
+func TestRepositoryClientsShareActionsTokensAndRotateCredentials(t *testing.T) {
+	resetRepositoryAuth(t)
+	old := registrationRequests
+	registrationRequests = &authPacer{}
+	defer func() { registrationRequests = old }()
+	exchanges := 0
+	jwt := "eyJhbGciOiJSUzI1NiJ9." + base64.RawURLEncoding.EncodeToString([]byte(fmt.Sprintf(`{"exp":%d}`, time.Now().Add(time.Hour).Unix()))) + ".fixture"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		exchanges++
+		fmt.Fprintf(w, `{"url":"https://example.invalid/","token":%q}`, jwt)
+	}))
+	defer server.Close()
+	u, _ := url.Parse(server.URL)
+	first, second := &registrationFake{u: u}, &registrationFake{u: u}
+	for _, fake := range []*registrationFake{first, second} {
+		client := &ScaleSetClient{ghCli: fake, httpClient: server.Client()}
+		if err := client.ensureAdminInfo(context.Background()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if first.calls != 1 || second.calls != 0 || exchanges != 1 {
+		t.Fatal("repository clients did not share authentication")
+	}
+	second.payload = `{"key":"rotated-fixture"}`
+	client := &ScaleSetClient{ghCli: second, httpClient: server.Client()}
+	if err := client.ensureAdminInfo(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if second.calls != 1 || exchanges != 2 {
+		t.Fatal("credential rotation reused old authentication")
+	}
+}
+
+func TestQueuedAuthWaitCanBeCancelled(t *testing.T) {
+	p := &authPacer{interval: time.Hour}
+	if err := p.wait(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	owner, cancelOwner := context.WithCancel(context.Background())
+	defer cancelOwner()
+	done := make(chan error, 1)
+	go func() { done <- p.wait(owner) }()
+	deadline := time.Now().Add(time.Second)
+	for {
+		p.mu.Lock()
+		queued := len(p.turn) == 1
+		p.mu.Unlock()
+		if queued {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("waiter failed to acquire queue slot")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if !errors.Is(p.wait(ctx), context.Canceled) {
+		t.Fatal("queued request ignored cancellation")
+	}
+	cancelOwner()
+	if !errors.Is(<-done, context.Canceled) {
+		t.Fatal("queue owner ignored cancellation")
+	}
+}
